cat >> .gitignore <<'EOF'

# All Python environments
venv/
.venv/
.venv-1/
backend/venv/

# Environment variables and secrets
.env
.env.*
!.env.example
frontend/.env

# Node dependencies
node_modules/

# Python generated files
__pycache__/
*.py[cod]
*.egg-info/

# Build files
dist/
build/

# Local databases
*.db
*.sqlite3

# Logs and temporary files
*.log
*.tmp
EOF